# Copiá este archivo como ".env" (en la misma carpeta) y completá tus datos.
# El .env no se sube a git. Si tu clave tiene una barra invertida \ escribila doble: \\

# --- MySQL de tu computadora ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=luma
MYSQL_USER=root
MYSQL_PASSWORD=root

# Cualquier frase larga. Hace que la sesión siga iniciada aunque reinicies el servidor.
JWT_SECRET=cambiame-por-una-frase-larga-y-secreta

# Opcional: si la completás, las fotos y STLs se suben a Cloudinary.
# Si queda vacía, se guardan en la carpeta "uploads" del proyecto.
CLOUDINARY_URL=
